# GEMINI_API_KEY: Required for Gemini AI API calls and smart financial insights.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/fintech_db)
DATABASE_URL="postgresql://user:password@localhost:5432/fintech_db"

# PLAID_CLIENT_ID: Your Plaid Client ID from dashboard.plaid.com
PLAID_CLIENT_ID=""

# PLAID_SECRET: Your Plaid Secret key
PLAID_SECRET=""

# PLAID_ENV: Plaid environment: sandbox, development, or production
PLAID_ENV="sandbox"

# ENCRYPTION_KEY: 32-character AES secret key for encrypting stored Plaid access tokens at rest
ENCRYPTION_KEY="default_fintech_secure_encryption_key_32bytes"

# AUTH_SECRET: JWT secret for signing auth session tokens
AUTH_SECRET="default_jwt_auth_secret_personal_finance"
